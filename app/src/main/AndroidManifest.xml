<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== ハイウェイモード ===== -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===== Spectrum ===== -->
    <!-- Visualizer で端末の出力音を解析するために必要 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 音声の番号を知らせないアプリ(YouTube など)の音を解析するため。
         Shizuku（アプリ内のボタン）か、パソコンから adb shell pm grant <アプリのID> android.permission.DUMP で許可する -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- ===== Android Auto（ナビ用テンプレートと地図面への描画） ===== -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <!-- Android Auto: 車速・燃料（航続距離） -->
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_FUEL" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <!-- 「Android Auto の状態」で Android Auto の版を調べるため -->
        <package android:name="com.google.android.projection.gearhead" />
        <!-- Spectrum: 再生中の音楽アプリを開くために、音楽アプリ・起動可能なアプリを見えるようにする -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Spectrum: Shizuku が入っているか確認するため -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HighwayMode">

        <!-- スマホの画面（Spectrum とハイウェイモードを自動で切替） -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Spectrum: 曲情報の取得状況を確認する画面(音楽画面の何もない場所を20回連続タップ、またはメニューから) -->
        <activity
            android:name="com.example.spectrum.DiagnosticsActivity"
            android:exported="false"
            android:label="Spectrum 診断" />

        <service
            android:name=".TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".data.DataSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Spectrum: 再生中の曲情報を取得 -->
        <service
            android:name="com.example.spectrum.MediaListenerService"
            android:exported="true"
            android:label="Spectrum media listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Android Auto（Spectrum とハイウェイモードを 1 つの画面で） -->
        <service
            android:name=".car.HighwayCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Spectrum: Shizuku との接続口(パソコンなしで DUMP 権限を許可するため) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Spectrum: 音楽アプリのオーディオセッション開始/終了の通知 -->
        <receiver
            android:name="com.example.spectrum.AudioSessionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
    </application>

</manifest>
